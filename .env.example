# ---- Google Earth Engine (required for layers and analysis) ----------------
# Service-account JSON key, either raw JSON on one line or base64-encoded.
GEE_SERVICE_ACCOUNT_KEY=
# Cloud project registered for Earth Engine (defaults to project_id in the key).
GEE_PROJECT=
# Optional: your upload of Sanderman et al. 2018 soil carbon (Mg C/ha).
GEE_SOC_ASSET=

# ---- Public-instance limits --------------------------------------------------
ANALYSIS_MAX_AREA_HA=250000
ANALYSIS_MAX_VERTICES=20000
RATE_LIMIT_ANALYSES_PER_HOUR=30
RATE_LIMIT_LAYER_REQUESTS_PER_HOUR=600

# ---- Front-end ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://atlas.floracarbon.ai
NEXT_PUBLIC_REPO_URL=https://github.com/floracarbon/flora-mangrove-atlas
NEXT_PUBLIC_PRO_URL=https://floracarbon.ai
# Number formatting locale, e.g. "en" (1,234,567) or "en-IN" (12,34,567).
NEXT_PUBLIC_NUMBER_LOCALE=en
# Optional overrides for basemaps / geocoder (all keyless by default).
# NEXT_PUBLIC_SATELLITE_TILES=https://…/{z}/{y}/{x}.jpg
# NEXT_PUBLIC_STREETS_STYLE=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io/api/
# Set to true only if your Esri licence allows it.
NEXT_PUBLIC_ENABLE_ESRI_IMAGERY=false
